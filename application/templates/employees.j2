{% extends "main.j2" %}
{% block content %}

<h1>Aquarium Employees</h1>

{# READ table #}
<table>
    <thead>
        {# For the table header row, we print the DB attribute names and an empty one column for delete buttons.#}
        <tr>
            {#
            {% for key in employees[0].keys() %}
                <th>{{ key }}</th>
            {% endfor %}
            <th></th>
            #}
            <th>Employee ID</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Age</th>
            <th>Employment Type</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {# For each row, print the employeeID, firstName, lastName, age, employmentStatus #}
        {% for employee in employees %}
            <tr>
                <td>{{ employee.employeeID       }}</td>
                <td>{{ employee.firstName        }}</td>
                <td>{{ employee.lastName         }}</td>
                <td>{{ employee.age              }}</td>
                <td>{{ employee.employmentStatus }}</td>

                {# DELETE form #}
                <form id="delete_person_form" method="POST" action="/employees/delete">
                    {# Only ID is enough to delete the Employee. 2, 3 and 4th input are not necessary. #}
                    <input type="hidden" name="delete_person_id" value="{{ employee.employeeID  }}">
                    <input type="hidden" name="delete_person_name" value="{{ employee.firstName }} {{ employee.lastName }}">
                    <input type="hidden" name="delete_person_age" value="{{ employee.age }}">
                    <input type="hidden" name="delete_person_employment" value="{{ employee.employmentStatus }}">
                    <td>
                        <button type="submit">
                            Delete
                        </button>
                    </td>
                </form>
            </tr>
        {% endfor %}
    </tbody>
</table>

{# CREATE form #}
<h2>Create an Employee</h2>
<form class="cuForm" id="create_employee_form" method="POST" action="/employees/create">

    <fieldset>
        <label for="create_employee_first_name">Employee First Name: </label>
        <input type="text" name="create_employee_first_name" id="create_employee_first_name" required>

        <label for="create_employee_last_name">Employee Last Name: </label>
        <input type="text" name="create_employee_last_name" id="create_employee_last_name" required>

        <label for="create_employee_employment_status">Employment Status: </label>
        <select name="create_employee_status" id="create_employee_status" required>
            <option value="" disabled selected>Select an Employment Status</option>
            <option value="Part-time">Part-time</option>
            <option value="Full-time">Full-time</option>
            <option value="As-needed">As-needed</option>
        </select>

        <label for="create_employee_age">Age: </label>
        <input type="number" name="create_employee_age" id="create_employee_age" min="0" max="100">

        <input type="submit">
    </fieldset>
</form>

{# UPDATE form #}
<h2>Update an Employee</h2>
<form class="cuForm" id="update_employee_form" method="POST" action="/employees/update">
    <fieldset>
        <label for="update_employee_id">Employee: </label>
        <select name="update_employee_id" id="update_employee_id" required>
            <option value="" disabled selected>Select an Employee</option>
            {% for employee in employees %}
                <option value="{{employee['employeeID']}}" required>
                    {{employee['employeeID']}}
                    -
                    {{employee['firstName']}}
                    {{employee['lastName']}} 
                </option>
            {% endfor %}
        </select>

        <label for="update_employee_first_name">First Name: </label>
        <input type="text" name="update_employee_first_name" id="update_employee_first_name" required>

        <label for="update_employee_last_name">Last Name: </label>
        <input type="text" name="update_employee_last_name" id="update_employee_last_name" required>

        <label for="update_employee_employment_status">Employment Status: </label>
        <select name="update_employee_employment_status" id="update_employee_employment_status" required>
            <option value="" disabled selected>Select an Employment Status</option>
            <option value="Part-time">Part-time</option>
            <option value="Full-time">Full-time</option>
            <option value="As-needed">As-needed</option>
        </select>

        <label for="update_employee_age">Age: </label>
        <input type="number" name="update_employee_age" id="update_employee_age" min="0" required>

        <input type="submit">
    </fieldset>
</form>

{% endblock %}