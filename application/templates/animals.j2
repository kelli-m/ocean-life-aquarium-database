{# CREATE form #}
<h2>Create an Animal</h2>
<form class="cuForm" id="create_animal_form" method = "POST" action="/animals/create">
    
    <fieldset>
        <label for="create_animal_name">Animal Name: </label>
        <input type="text" name="create_animal_name" id="create_animal_name" required>

        <label for="create_animal_species">Animal Species: </label>
        <input type="text" name="create_animal_species" id="create_animal_species" required>

        <input type="submit">
    </fieldset>

</form>

{# UPDATE form #}
<h2>Update an Animal</h2>
<form class="cuForm" id="update_animal_form" method="POST" action="/animals/update">
    <fieldset>
        <label for="update_animal_id">Animal: </label>
        <select name="update_animal_id" id="update_animal_id" required>
            <option value="" disabled selected>Select an Animal</option>
            {% for animal in animals %}
                <option value="{{animal['animalID']}}" required>
                    {{animal['animalID']}}
                    -
                    {{animal['animalName']}}
                </option>
            {% endfor %}
        </select>
        
        <label for="update_animal_name">Name: </label>
        <input type="text" name="update_animal_name" id="update_animal_name">

        <label for="update_animal_species">Species: </label>
        <input type="text" name="update_animal_species" id="update_animal_species">

        <input type="submit">
    </fieldset>
</form>

{% endblock %}