{% extends "main.j2" %}
{% block content %}

<h1>Aquarium Animals</h1>

{# READ table #}
<table>
    <thead>
        {# For the table header row, we print the DB attribute names and an empty one column for delete buttons. #}
        <tr>
            {#{% for key in animals[0].keys() %}
                <th>{{ key }}</th>
            {% endfor %}
            <th></th>#}
            <th>Animal's ID</th>
            <th>Animal's Name</th>
            <th>Animal's Species</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        {# For each row, print the animalID, animalName, species #}
        {% for animal in animals %}
            <tr>
                <td>{{ animal.animalID }}  </td>
                <td>{{ animal.animalName }}</td>
                <td>{{ animal.species }}   </td>

                {# DELETE form #}
                <form id="delete_animal_form" method="POST" action="/animals/delete">
                    {# Only ID is enough to delete the Animal. 2 and 3rd input are not necessary. #}
                    <input type="hidden" name="delete_animal_id"       value="{{ animal.animalID }}  ">
                    <input type="hidden" name="delete_animal_name"    value="{{ animal.animalName }}">
                    <input type="hidden" name="delete_animal_species" value="{{ animal.species }}   ">
                    <td>
                        <button type="submit">
                            Delete
                        </button>
                    </td>
                </form>
            </tr>
        {% endfor %}
    </tbody>
</table>

